# Dependencies
node_modules/

# Build & packaging outputs
dist/
out/
build/

# Runtime / local user data
# The app writes its real settings to app.getPath('userData'), but ignore any
# stray copy in the repo -- it holds a Riot API key.
settings.json
.env
.env.*
*.local
*.log
npm-debug.log*

# OS & System files
.DS_Store
Thumbs.db
ehthumbs.db

# IDE & Code Editor settings
.vscode/
.idea/
*.swp
*.swo

# Agent tooling -- local machine state only. .claude/settings.json (shared
# project config) and CLAUDE.md are meant to be committed.
.claude/settings.local.json
docs/TODO.txt

# Docs GIF pipeline: the capture/encode scripts and their notes ARE committed,
# the intermediate frames they emit are not -- ~2.7MB of regenerable PNGs whose
# only meaningful output, docs/overlay-sheen.gif, is committed instead.
docs/_gif-build/frame-*.png
docs/_gif-build/frames.json
