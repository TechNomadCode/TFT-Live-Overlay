# Dependencies
node_modules/

# Build & packaging outputs. dist-*/ covers the one-off output dirs you end up
# using when a running copy of the app has dist/ locked -- electron-builder
# -c.directories.output=dist-whatever. Windows keeps a handle on win-unpacked
# while the packaged app is running, so this happens more than you'd expect.
dist/
dist-*/
out/
build/

# Runtime / local user data
# The app writes its real settings to app.getPath('userData'), but ignore any
# stray copy in the repo -- it holds a Riot API key.
settings.json
.env
.env.*
*.local
*.log
npm-debug.log*

# OS & System files
.DS_Store
Thumbs.db
ehthumbs.db

# IDE & Code Editor settings
.vscode/
.idea/
*.swp
*.swo

# Agent tooling -- local machine state only. .claude/settings.json (shared
# project config) and CLAUDE.md are meant to be committed.
.claude/settings.local.json
docs/TODO.txt

# Docs capture pipeline: the capture/encode scripts and their notes ARE
# committed, the intermediate frames they emit are not -- tens of MB of
# regenerable PNGs. Only what encode.js makes of them (docs/overlay-live.gif,
# docs/overlay-moment.gif) and docs/overlay-tiers.png are committed.
docs/_gif-build/*-[0-9][0-9][0-9].png
docs/_gif-build/frames-*.json
