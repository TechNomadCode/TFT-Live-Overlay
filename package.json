{
  "name": "tft-live-overlay",
  "version": "1.0.0",
  "description": "Tracks TFT rank and LP with low latency and presents them in an animated overlay for Streamlabs and OBS (Browser Source)",
  "main": "src/main/index.js",
  "author": "Tech Nomad (@Splenk__ on twitch for TFT streams)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.splenk.tftliveoverlay",
    "productName": "TFT Live Overlay",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon-512.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon-256.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon-256.png"
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  }
}
