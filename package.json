{
  "name": "tft-live-overlay",
  "version": "1.2.0",
  "description": "Tracks TFT rank and LP with low latency and presents them in an animated overlay for Streamlabs and OBS (Browser Source)",
  "main": "src/main/index.js",
  "author": "Tech Nomad (@Splenk__ on twitch for TFT streams)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TechNomadCode/TFT-Live-Overlay.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "com.splenk.tftliveoverlay",
    "productName": "TFT Live Overlay",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "artifactName": "${name}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "TechNomadCode",
        "repo": "TFT-Live-Overlay"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon-256.png",
      "category": "Utility",
      "artifactName": "${name}-linux-x86_64.${ext}"
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  }
}
